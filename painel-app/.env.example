# Copie para .env.local e preencha (Supabase > Project Settings > API Keys).
# Só a chave PUBLISHABLE vai para o navegador. A secret NUNCA entra aqui:
# ela fica só nas variáveis de ambiente da Vercel (SUPABASE_SECRET_KEY), usada pela função /api/admin.
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
